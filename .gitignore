# Files git should NOT track.
# .claude/ holds local tooling config specific to this machine.
.claude/

# dev-tooling dependencies (restore with: npm install)
node_modules/

# reference frames from the Genie 3 video (copyrighted footage — local only)
ref/

# capture-script output (regenerate with: npm run shot)
shots/
ref2/

# Tripo character work files: ship the .glb + meta.json, skip nothing else
# (tools/glb_shrink.js --inplace leaves a full-size .orig.glb backup beside
#  the shrunk model — local undo only, never worth committing)
*.orig.glb
